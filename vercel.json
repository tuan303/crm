{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "packages/twenty-docker/twenty/Dockerfile#twenty"
    }
  },
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "packages/twenty-docker/twenty/Dockerfile#twenty-server",
      "command": ["node", "dist/queue-worker/queue-worker"],
      "instances": {
        "hnd1": 0
      },
      "resources": {
        "requests": {
          "memory": "2Gi"
        }
      },
      "terminationGracePeriodSeconds": 360
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
