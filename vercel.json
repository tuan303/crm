{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PORT": "3000"
  },
  "services": {
    "web": {
      "root": "tools/vercel-oidc-probe",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
